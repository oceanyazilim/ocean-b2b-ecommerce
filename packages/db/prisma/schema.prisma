// Ocean Commerce — PostgreSQL schema
//
// Tenant-owned tables carry organizationId (+ storeId when store-scoped). Every repository
// method must filter by them; see docs/architecture/08-multi-tenant-model.md.
// Sessions are stored in Redis, not here (docs/architecture/07-auth-and-rbac.md).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
}

enum UserTokenPurpose {
  email_verification
  password_reset
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  name            String
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tokens               UserToken[]
  organizationMembers  OrganizationMember[]
  storeMembers         StoreMember[]
  sentInvitations      Invitation[]
  mfa                  UserMfa?
  loginEvents          LoginEvent[]
  inventoryMovements   InventoryMovement[]
  transfersRequested   TransferRequest[]    @relation("TransferRequestedBy")
  transfersApproved    TransferRequest[]    @relation("TransferApprovedBy")
  managedCompanies     Company[]            @relation("CompanyAccountManager")
  reviewedApplications CompanyApplication[] @relation("ApplicationReviewer")
  placedOrders         Order[]              @relation("OrderPlacedBy")
  draftOrders          DraftOrder[]         @relation("DraftOrderCreatedBy")
  pagesCreated         Page[]
  blogsCreated         Blog[]
  articlesCreated      Article[]
  approvals            Approval[]
  notifications        Notification[]
  impersonatorSessions ImpersonationSession[] @relation("ImpersonatorUser")
  targetedSessions     ImpersonationSession[] @relation("TargetUser")

  @@map("users")
}

model UserMfa {
  userId             String    @id @map("user_id") @db.Uuid
  totpSecretEnc      String    @map("totp_secret_enc")
  enabledAt          DateTime? @map("enabled_at") @db.Timestamptz(6)
  recoveryCodeHashes String[]  @default([]) @map("recovery_code_hashes")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

enum LoginOutcome {
  success
  failed_password
  failed_mfa
  mfa_required
  locked
}

model LoginEvent {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  email     String
  ip        String?
  userAgent String?      @map("user_agent")
  outcome   LoginOutcome
  riskFlags String[]     @default([]) @map("risk_flags")
  sessionId String?      @map("session_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
  @@map("login_events")
}

model UserToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("user_tokens")
}

// ---------------------------------------------------------------------------
// Platform operators — Ocean's own internal staff, never a merchant or store member.
// Deliberately a separate identity model from User: apps/platform-admin is a genuinely separate
// internal application with its own session realm ("platform", see
// apps/api/src/common/auth/session.types.ts), so a merchant account (however over-permissioned)
// can never reach the cross-tenant platform surface, and a platform operator's account carries
// no organization/store membership to accidentally scope-leak from. Rows are provisioned by an
// operator (seed/console), not self-serve signup.
// ---------------------------------------------------------------------------

enum PlatformOperatorStatus {
  active
  suspended
}

// viewer: read-only across every platform/* route (the "read-only by design" a controller like
// PlatformBillingController assumes of every operator, before this enum existed).
// operator: viewer, plus the mutating routes (feature-flag create/update/target).
// admin: operator, plus anything added later that should stay operator-only (e.g. provisioning
// other PlatformOperator rows, once that exists). Ordered low-to-high; guards compare by index,
// same shape as StoreRole/CompanyRole elsewhere in this schema.
enum PlatformOperatorRole {
  viewer
  operator
  admin
}

model PlatformOperator {
  id           String                 @id @default(uuid()) @db.Uuid
  email        String                 @unique
  name         String
  passwordHash String                 @map("password_hash")
  status       PlatformOperatorStatus @default(active)
  // Defaults to the least-privileged role: a freshly provisioned operator can look but not touch
  // until someone deliberately elevates them (console/seed), not the other way around.
  role         PlatformOperatorRole   @default(viewer)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_operators")
}

// ---------------------------------------------------------------------------
// Tenancy: Organization -> Store
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  active
  suspended
}

enum OrganizationRole {
  owner
  admin
  billing
  member
}

enum MembershipStatus {
  active
  removed
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  members               OrganizationMember[]
  stores                Store[]
  storeMembers          StoreMember[]
  invitations           Invitation[]
  auditLogs             AuditLog[]
  products              Product[]
  collections           Collection[]
  media                 Media[]
  locations             Location[]
  inventoryItems        InventoryItem[]
  inventoryLevels       InventoryLevel[]
  transfers             TransferRequest[]
  customers             Customer[]
  companies             Company[]
  companyLocations      CompanyLocation[]
  companyUsers          CompanyUser[]
  companyApplications   CompanyApplication[]
  catalogs              Catalog[]
  priceLists            PriceList[]
  volumePricingRules    VolumePricingRule[]
  quantityRules         QuantityRule[]
  contractPrices        ContractPrice[]
  carts                 Cart[]
  orders                Order[]
  draftOrders           DraftOrder[]
  paymentMethods        PaymentMethod[]
  payments              Payment[]
  refunds               Refund[]
  shippingZones         ShippingZone[]
  fulfillments          Fulfillment[]
  returns               Return[]
  taxRules              TaxRule[]
  markets               Market[]
  pages                 Page[]
  blogs                 Blog[]
  articles              Article[]
  menus                 Menu[]
  redirects             Redirect[]
  domains               Domain[]
  storeThemes           StoreTheme[]
  quotes                Quote[]
  paymentTermsTemplates PaymentTermsTemplate[]
  invoices              Invoice[]
  approvalRules         ApprovalRule[]
  approvals             Approval[]
  savedLists            SavedList[]
  discounts             Discount[]
  subscription          Subscription?
  platformInvoices      PlatformInvoice[]
  featureFlagTargets    FeatureFlagTarget[]
  ssoConnection         SsoConnection?

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

enum StoreStatus {
  setup
  active
  paused
  closed
}

enum StoreRole {
  store_owner
  admin
  store_manager
  product_manager
  order_manager
  marketing
  finance
  developer
  viewer
  // A StoreMember with this role carries no built-in permissions of its own (see
  // STORE_ROLE_PERMISSIONS.custom in packages/permissions) — its actual grants come from
  // customRoleId, resolved by the same engine as the built-in roles (TenantService.forStore).
  custom
}

model Store {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  name             String
  slug             String      @unique
  defaultCurrency  String      @map("default_currency") @db.Char(3)
  defaultLocale    String      @map("default_locale")
  timezone         String
  status           StoreStatus @default(setup)
  businessType     String?     @map("business_type")
  industry         String?
  pricesIncludeTax Boolean     @default(false) @map("prices_include_tax")
  onboardingState  Json        @default("{}") @map("onboarding_state")
  orderSequence    Int         @default(1000) @map("order_sequence")
  draftSequence    Int         @default(1000) @map("draft_sequence")
  quoteSequence    Int         @default(1000) @map("quote_sequence")
  invoiceSequence  Int         @default(1000) @map("invoice_sequence")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members               StoreMember[]
  invitations           Invitation[]
  auditLogs             AuditLog[]
  products              Product[]
  variants              ProductVariant[]
  categories            Category[]
  collections           Collection[]
  media                 Media[]
  metafieldDefinitions  MetafieldDefinition[]
  metafields            Metafield[]
  events                DomainEvent[]
  locations             Location[]
  inventoryItems        InventoryItem[]
  inventoryLevels       InventoryLevel[]
  movements             InventoryMovement[]
  transfers             TransferRequest[]
  customers             Customer[]
  companies             Company[]
  companyLocations      CompanyLocation[]
  companyUsers          CompanyUser[]
  companyApplications   CompanyApplication[]
  catalogs              Catalog[]
  priceLists            PriceList[]
  volumePricingRules    VolumePricingRule[]
  quantityRules         QuantityRule[]
  contractPrices        ContractPrice[]
  carts                 Cart[]
  orders                Order[]
  draftOrders           DraftOrder[]
  idempotencyKeys       IdempotencyKey[]
  paymentMethods        PaymentMethod[]
  payments              Payment[]
  refunds               Refund[]
  shippingZones         ShippingZone[]
  fulfillments          Fulfillment[]
  returns               Return[]
  taxRules              TaxRule[]
  markets               Market[]
  pages                 Page[]
  blogs                 Blog[]
  articles              Article[]
  menus                 Menu[]
  redirects             Redirect[]
  domains               Domain[]
  storeThemes           StoreTheme[]
  quotes                Quote[]
  paymentTermsTemplates PaymentTermsTemplate[]
  invoices              Invoice[]
  approvalRules         ApprovalRule[]
  approvals             Approval[]
  savedLists            SavedList[]
  discounts             Discount[]
  notifications         Notification[]
  featureFlagTargets    FeatureFlagTarget[]
  developerApps         DeveloperApp[]
  apiKeys               ApiKey[]
  webhooks              Webhook[]
  customRoles           CustomRole[]
  impersonationSessions ImpersonationSession[]

  @@index([organizationId])
  @@map("stores")
}

model StoreMember {
  id             String           @id @default(uuid()) @db.Uuid
  storeId        String           @map("store_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           StoreRole
  customRoleId   String?          @map("custom_role_id") @db.Uuid
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([storeId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("store_members")
}

model Invitation {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  storeId          String?           @map("store_id") @db.Uuid
  email            String
  organizationRole OrganizationRole? @map("organization_role")
  storeRole        StoreRole?        @map("store_role")
  tokenHash        String            @unique @map("token_hash")
  invitedById      String            @map("invited_by_id") @db.Uuid
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?         @map("accepted_at") @db.Timestamptz(6)
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([storeId, email])
  @@index([organizationId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum ActorType {
  user
  platform
  system
  customer
  guest
}

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  storeId        String?   @map("store_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  action         String
  resourceType   String    @map("resource_type")
  resourceId     String?   @map("resource_id")
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?   @map("user_agent")
  sessionId      String?   @map("session_id")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  store        Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog: products, variants, media, categories
// ---------------------------------------------------------------------------

enum ProductStatus {
  draft
  active
  archived
}

enum WeightUnit {
  g
  kg
  lb
  oz
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  storeId         String        @map("store_id") @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  title           String
  handle          String
  descriptionHtml String        @default("") @map("description_html")
  vendor          String?
  productType     String?       @map("product_type")
  categoryId      String?       @map("category_id") @db.Uuid
  status          ProductStatus @default(draft)
  tags            String[]      @default([])
  seoTitle        String?       @map("seo_title")
  seoDescription  String?       @map("seo_description")
  templateSuffix  String?       @map("template_suffix")
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  version         Int           @default(1)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options      ProductOption[]
  variants     ProductVariant[]
  media        ProductMedia[]
  collections  CollectionProduct[]
  catalogs     CatalogProduct[]

  @@unique([storeId, handle])
  @@index([storeId, status, updatedAt(sort: Desc)])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, vendor])
  @@index([storeId, productType])
  @@map("products")
}

model ProductOption {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(uuid()) @db.Uuid
  optionId String @map("option_id") @db.Uuid
  value    String
  position Int

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

model ProductVariant {
  id               String     @id @default(uuid()) @db.Uuid
  productId        String     @map("product_id") @db.Uuid
  storeId          String     @map("store_id") @db.Uuid
  title            String
  sku              String?
  barcode          String?
  price            BigInt
  compareAtPrice   BigInt?    @map("compare_at_price")
  cost             BigInt?
  weight           Decimal?   @db.Decimal(12, 3)
  weightUnit       WeightUnit @default(kg) @map("weight_unit")
  taxable          Boolean    @default(true)
  requiresShipping Boolean    @default(true) @map("requires_shipping")
  position         Int
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  optionValues    VariantOptionValue[]
  inventoryItems  InventoryItem[]
  priceListPrices PriceListPrice[]
  contractPrices  ContractPrice[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  draftOrderItems DraftOrderItem[]
  quoteItems      QuoteItem[]
  savedListItems  SavedListItem[]

  @@index([productId, position])
  @@index([storeId, sku])
  @@index([storeId, barcode])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

enum MediaKind {
  image
  video
  document
}

model Media {
  id               String    @id @default(uuid()) @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  kind             MediaKind
  storageKey       String    @unique @map("storage_key")
  mime             String
  bytes            Int
  width            Int?
  height           Int?
  alt              String?
  originalFilename String    @map("original_filename")
  createdById      String?   @map("created_by_id") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  store                Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products             ProductMedia[]
  collections          Collection[]
  applicationDocuments CompanyApplicationDocument[]
  quoteAttachments     QuoteAttachment[]

  @@index([storeId, kind, createdAt(sort: Desc)])
  @@map("media")
}

model ProductMedia {
  productId String @map("product_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid
  position  Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([productId, position])
  @@map("product_media")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  handle    String
  path      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, path])
  @@index([storeId, parentId, position])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Collections
// ---------------------------------------------------------------------------

enum CollectionType {
  manual
  automated
}

enum CollectionSortOrder {
  manual
  title_asc
  title_desc
  created_desc
  price_asc
  price_desc
}

enum CollectionProductSource {
  manual
  rule
}

model Collection {
  id              String              @id @default(uuid()) @db.Uuid
  storeId         String              @map("store_id") @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  title           String
  handle          String
  descriptionHtml String              @default("") @map("description_html")
  type            CollectionType
  rules           Json                @default("[]")
  rulesMatchAll   Boolean             @default(true) @map("rules_match_all")
  sortOrder       CollectionSortOrder @default(manual) @map("sort_order")
  imageMediaId    String?             @map("image_media_id") @db.Uuid
  seoTitle        String?             @map("seo_title")
  seoDescription  String?             @map("seo_description")
  publishedAt     DateTime?           @map("published_at") @db.Timestamptz(6)
  version         Int                 @default(1)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  image        Media?              @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  products     CollectionProduct[]

  @@unique([storeId, handle])
  @@index([storeId, type, updatedAt(sort: Desc)])
  @@map("collections")
}

model CollectionProduct {
  collectionId String                  @map("collection_id") @db.Uuid
  productId    String                  @map("product_id") @db.Uuid
  position     Int                     @default(0)
  source       CollectionProductSource @default(manual)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId, position])
  @@index([productId])
  @@map("collection_products")
}

// ---------------------------------------------------------------------------
// Metafields
// ---------------------------------------------------------------------------

enum MetafieldOwnerType {
  product
  variant
  collection
  company
  order
  customer
}

enum MetafieldType {
  single_line_text
  multi_line_text
  integer
  decimal
  boolean
  date
  json
  url
  product_reference
  collection_reference
  file_reference
}

model MetafieldDefinition {
  id          String             @id @default(uuid()) @db.Uuid
  storeId     String             @map("store_id") @db.Uuid
  ownerType   MetafieldOwnerType @map("owner_type")
  namespace   String
  key         String
  name        String
  description String?
  type        MetafieldType
  validations Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  metafields Metafield[]

  @@unique([storeId, ownerType, namespace, key])
  @@map("metafield_definitions")
}

model Metafield {
  id           String             @id @default(uuid()) @db.Uuid
  storeId      String             @map("store_id") @db.Uuid
  ownerType    MetafieldOwnerType @map("owner_type")
  ownerId      String             @map("owner_id") @db.Uuid
  definitionId String?            @map("definition_id") @db.Uuid
  namespace    String
  key          String
  type         MetafieldType
  value        Json
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  definition MetafieldDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)

  @@unique([storeId, ownerType, ownerId, namespace, key])
  @@index([storeId, ownerType, ownerId])
  @@map("metafields")
}

// ---------------------------------------------------------------------------
// Domain events (transactional outbox)
// ---------------------------------------------------------------------------

model DomainEvent {
  id             String    @id @default(uuid()) @db.Uuid
  storeId        String?   @map("store_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  type           String
  version        Int       @default(1)
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  payload        Json
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Its own marker, not reused from publishedAt: the Phase 13 NotificationsRelayService already
  // claims publishedAt for every row regardless of type, so a second consumer (WebhookDispatchService,
  // Phase 15) needs its own cursor rather than racing/overloading that one column.
  webhookRelayedAt DateTime? @map("webhook_relayed_at") @db.Timestamptz(6)

  @@index([publishedAt, occurredAt])
  @@index([storeId, type, occurredAt(sort: Desc)])
  @@index([webhookRelayedAt, occurredAt])
  @@map("domain_events")
}

// In-app notification, fanned out to every active store member by the DomainEvent relay
// (apps/api/src/modules/notifications/notifications-relay.service.ts) for a small set of
// event types worth a staff member's attention (new order, quote accepted, ...).
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String
  title          String
  body           String
  data           Json?
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

enum InventoryTrackingType {
  variant
  sku
  upc
}

enum InventoryMovementReason {
  adjustment
  transfer
  return
  damage
  count
  fulfillment
}

enum InventoryMovementSource {
  manual
  system
  import
}

enum TransferStatus {
  pending
  approved
  rejected
  cancelled
}

model Location {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  type           String   @default("warehouse")
  address        String?
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store           Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]
  movementsFrom   InventoryMovement[]    @relation("FromLocation")
  movementsTo     InventoryMovement[]    @relation("ToLocation")
  transfersFrom   TransferRequest[]      @relation("FromLocation")
  transfersTo     TransferRequest[]      @relation("ToLocation")
  reservations    OrderItemReservation[]
  fulfillments    Fulfillment[]

  @@unique([storeId, name])
  @@index([storeId, isActive, isDefault])
  @@map("locations")
}

model InventoryItem {
  id               String                @id @default(uuid()) @db.Uuid
  storeId          String                @map("store_id") @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  productVariantId String?               @map("product_variant_id") @db.Uuid
  sku              String?
  upc              String?
  trackingType     InventoryTrackingType @map("tracking_type")
  onHand           Int                   @default(0) @map("on_hand")
  committed        Int                   @default(0)
  reserved         Int                   @default(0)
  damaged          Int                   @default(0)
  lastMovedAt      DateTime?             @map("last_moved_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  store            Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant?        @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  levels           InventoryLevel[]
  movements        InventoryMovement[]
  transferRequests TransferRequest[]
  reservations     OrderItemReservation[]

  // Partial unique indexes (WHERE ... IS NOT NULL) are added in the migration SQL.
  @@index([storeId, productVariantId])
  @@index([storeId, sku])
  @@index([storeId, upc])
  @@map("inventory_items")
}

model InventoryLevel {
  id             String    @id @default(uuid()) @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  locationId     String    @map("location_id") @db.Uuid
  quantity       Int       @default(0)
  reserved       Int       @default(0)
  damaged        Int       @default(0)
  lastMovedAt    DateTime? @map("last_moved_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([storeId, locationId])
  @@index([itemId])
  @@map("inventory_levels")
}

model InventoryMovement {
  id             String                  @id @default(uuid()) @db.Uuid
  storeId        String                  @map("store_id") @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  itemId         String                  @map("item_id") @db.Uuid
  fromLocationId String?                 @map("from_location_id") @db.Uuid
  toLocationId   String?                 @map("to_location_id") @db.Uuid
  quantity       Int
  reason         InventoryMovementReason
  reference      String?
  source         InventoryMovementSource @default(manual)
  notes          String?
  createdById    String                  @map("created_by_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLocation Location?     @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location?     @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, itemId])
  @@index([storeId, reason])
  @@index([storeId, fromLocationId])
  @@index([storeId, toLocationId])
  @@map("inventory_movements")
}

model TransferRequest {
  id              String         @id @default(uuid()) @db.Uuid
  storeId         String         @map("store_id") @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  fromLocationId  String         @map("from_location_id") @db.Uuid
  toLocationId    String         @map("to_location_id") @db.Uuid
  itemId          String         @map("item_id") @db.Uuid
  quantity        Int
  status          TransferStatus @default(pending)
  requestedById   String         @map("requested_by_id") @db.Uuid
  approvedById    String?        @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(6)
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromLocation Location      @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location      @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requestedBy  User          @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy   User?         @relation("TransferApprovedBy", fields: [approvedById], references: [id])

  @@index([storeId, status])
  @@index([storeId, createdAt(sort: Desc)])
  @@map("transfer_requests")
}

// ---------------------------------------------------------------------------
// Customers & B2B companies
// ---------------------------------------------------------------------------

enum CustomerStatus {
  active
  disabled
}

enum MarketingConsent {
  not_subscribed
  subscribed
  unsubscribed
}

// Shoppers and company buyers share one record; the buyer facet is the company membership.
// Storefront login (Phase 8) fills password_hash / account_activated_at.
model Customer {
  id                      String           @id @default(uuid()) @db.Uuid
  storeId                 String           @map("store_id") @db.Uuid
  organizationId          String           @map("organization_id") @db.Uuid
  email                   String
  firstName               String?          @map("first_name")
  lastName                String?          @map("last_name")
  phone                   String?
  status                  CustomerStatus   @default(active)
  tags                    String[]         @default([])
  note                    String?
  locale                  String?
  taxExempt               Boolean          @default(false) @map("tax_exempt")
  emailMarketing          MarketingConsent @default(not_subscribed) @map("email_marketing")
  emailMarketingUpdatedAt DateTime?        @map("email_marketing_updated_at") @db.Timestamptz(6)
  passwordHash            String?          @map("password_hash")
  accountActivatedAt      DateTime?        @map("account_activated_at") @db.Timestamptz(6)
  ordersCount             Int              @default(0) @map("orders_count")
  totalSpent              BigInt           @default(0) @map("total_spent")
  lastOrderAt             DateTime?        @map("last_order_at") @db.Timestamptz(6)
  version                 Int              @default(1)
  deletedAt               DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addresses    CustomerAddress[]
  companyUsers CompanyUser[]
  applications CompanyApplication[]
  carts        Cart[]
  orders       Order[]
  draftOrders  DraftOrder[]
  quotes       Quote[]
  savedLists   SavedList[]

  // Partial unique index on (store_id, email) WHERE deleted_at IS NULL lives in the migration.
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, status])
  @@index([storeId, email])
  @@index([storeId, lastName, firstName])
  @@map("customers")
}

model CustomerAddress {
  id                String   @id @default(uuid()) @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  // Validated postal address document (see addressSchema in @ocean/types).
  address           Json
  isDefaultShipping Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean  @default(false) @map("is_default_billing")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([storeId])
  @@map("customer_addresses")
}

enum CompanyStatus {
  active
  suspended
  archived
}

model Company {
  id               String        @id @default(uuid()) @db.Uuid
  storeId          String        @map("store_id") @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  legalName        String        @map("legal_name")
  displayName      String        @map("display_name")
  taxNumber        String?       @map("tax_number")
  taxOffice        String?       @map("tax_office")
  industry         String?
  currency         String        @db.Char(3)
  status           CompanyStatus @default(active)
  accountManagerId String?       @map("account_manager_id") @db.Uuid
  externalId       String?       @map("external_id")
  website          String?
  phone            String?
  email            String?
  note             String?
  tags             String[]      @default([])
  version          Int           @default(1)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountManager       User?                 @relation("CompanyAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  locations            CompanyLocation[]
  users                CompanyUser[]
  applications         CompanyApplication[]
  catalogAssignments   CatalogAssignment[]
  priceListAssignments PriceListAssignment[]
  contractPrices       ContractPrice[]
  carts                Cart[]
  orders               Order[]
  draftOrders          DraftOrder[]
  quotes               Quote[]
  creditAccounts       CreditAccount[]
  invoices             Invoice[]
  approvalRules        ApprovalRule[]
  savedLists           SavedList[]

  // Partial unique index on (store_id, tax_number) WHERE tax_number IS NOT NULL AND deleted_at IS NULL in the migration.
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, status])
  @@index([storeId, displayName])
  @@index([storeId, accountManagerId])
  @@map("companies")
}

// A branch / ship-to site of a company. Catalog, price list, payment terms and credit attach
// here in Phases 5 and 12; the location itself carries only what every order needs.
model CompanyLocation {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String
  externalId      String?  @map("external_id")
  phone           String?
  email           String?
  shippingAddress Json     @map("shipping_address")
  // null = same as shipping
  billingAddress  Json?    @map("billing_address")
  // null = company currency
  currency        String?  @db.Char(3)
  taxExempt       Boolean  @default(false) @map("tax_exempt")
  taxNumber       String?  @map("tax_number")
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userAccess           CompanyUserLocation[]
  catalogAssignments   CatalogAssignment[]
  priceListAssignments PriceListAssignment[]
  contractPrices       ContractPrice[]
  carts                Cart[]
  orders               Order[]
  draftOrders          DraftOrder[]
  quotes               Quote[]
  creditAccounts       CreditAccount[]

  // Partial unique index on (company_id) WHERE is_default = true in the migration.
  @@unique([companyId, name])
  @@index([storeId, companyId])
  @@map("company_locations")
}

enum CompanyRole {
  company_admin
  buyer
  approver
  finance
  viewer
}

enum CompanyUserStatus {
  active
  disabled
}

// Membership of a customer in a company. `allLocations` = false restricts the user to the
// locations listed in company_user_locations.
model CompanyUser {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  customerId     String            @map("customer_id") @db.Uuid
  storeId        String            @map("store_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  role           CompanyRole
  status         CompanyUserStatus @default(active)
  title          String?
  allLocations   Boolean           @default(true) @map("all_locations")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations    CompanyUserLocation[]

  @@unique([companyId, customerId])
  @@index([storeId, customerId])
  @@index([storeId, companyId])
  @@map("company_users")
}

model CompanyUserLocation {
  companyUserId     String @map("company_user_id") @db.Uuid
  companyLocationId String @map("company_location_id") @db.Uuid

  companyUser CompanyUser     @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  location    CompanyLocation @relation(fields: [companyLocationId], references: [id], onDelete: Cascade)

  @@id([companyUserId, companyLocationId])
  @@index([companyLocationId])
  @@map("company_user_locations")
}

enum CompanyApplicationStatus {
  pending
  under_review
  approved
  rejected
}

enum CompanyApplicationSource {
  storefront
  admin
}

// A wholesale-account request. Approval creates the company, its default location and the
// contact as company admin; the application keeps a pointer to what it produced.
model CompanyApplication {
  id                    String                   @id @default(uuid()) @db.Uuid
  storeId               String                   @map("store_id") @db.Uuid
  organizationId        String                   @map("organization_id") @db.Uuid
  status                CompanyApplicationStatus @default(pending)
  source                CompanyApplicationSource @default(storefront)
  legalName             String                   @map("legal_name")
  displayName           String?                  @map("display_name")
  taxNumber             String?                  @map("tax_number")
  taxOffice             String?                  @map("tax_office")
  industry              String?
  website               String?
  expectedMonthlyVolume String?                  @map("expected_monthly_volume")
  contactFirstName      String                   @map("contact_first_name")
  contactLastName       String                   @map("contact_last_name")
  contactEmail          String                   @map("contact_email")
  contactPhone          String?                  @map("contact_phone")
  address               Json?
  message               String?
  customerId            String?                  @map("customer_id") @db.Uuid
  reviewerId            String?                  @map("reviewer_id") @db.Uuid
  reviewedAt            DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  decisionNote          String?                  @map("decision_note")
  companyId             String?                  @map("company_id") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?                    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reviewer     User?                        @relation("ApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  company      Company?                     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  documents    CompanyApplicationDocument[]

  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([storeId, contactEmail])
  @@map("company_applications")
}

model CompanyApplicationDocument {
  applicationId String   @map("application_id") @db.Uuid
  mediaId       String   @map("media_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application CompanyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  media       Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([applicationId, mediaId])
  @@map("company_application_documents")
}

// ---------------------------------------------------------------------------
// Catalog access & pricing
// ---------------------------------------------------------------------------

enum CatalogStatus {
  draft
  active
  archived
}

// Which products a company (or one of its locations) may see and buy. A buyer with at
// least one active catalog assigned is restricted to the union of those catalogs; a buyer
// with none sees the public assortment. Enforced server-side by CatalogAccessService.
model Catalog {
  id             String        @id @default(uuid()) @db.Uuid
  storeId        String        @map("store_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  description    String?
  status         CatalogStatus @default(draft)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     CatalogProduct[]
  assignments  CatalogAssignment[]

  @@unique([storeId, name])
  @@index([storeId, status])
  @@map("catalogs")
}

model CatalogProduct {
  catalogId String   @map("catalog_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([catalogId, productId])
  @@index([productId])
  @@map("catalog_products")
}

// Exactly one of company_id / company_location_id is set (CHECK in the migration).
model CatalogAssignment {
  id                String   @id @default(uuid()) @db.Uuid
  catalogId         String   @map("catalog_id") @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  companyId         String?  @map("company_id") @db.Uuid
  companyLocationId String?  @map("company_location_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  catalog  Catalog          @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  company  Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location CompanyLocation? @relation(fields: [companyLocationId], references: [id], onDelete: Cascade)

  @@index([catalogId])
  @@index([storeId, companyId])
  @@index([storeId, companyLocationId])
  @@map("catalog_assignments")
}

enum PriceListStatus {
  draft
  active
  archived
}

// A price list either fixes explicit variant prices or adjusts the base price by a
// percentage (basis points, negative = discount); explicit prices win over the adjustment.
// Multi-currency arrives with Markets (Phase 8): until then a list uses the store currency.
model PriceList {
  id             String          @id @default(uuid()) @db.Uuid
  storeId        String          @map("store_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String
  description    String?
  currency       String          @db.Char(3)
  status         PriceListStatus @default(draft)
  adjustmentBps  Int             @default(0) @map("adjustment_bps")
  priority       Int             @default(0)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prices       PriceListPrice[]
  assignments  PriceListAssignment[]
  volumeRules  VolumePricingRule[]

  @@unique([storeId, name])
  @@index([storeId, status, priority(sort: Desc)])
  @@map("price_lists")
}

model PriceListPrice {
  id             String   @id @default(uuid()) @db.Uuid
  priceListId    String   @map("price_list_id") @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  price          BigInt
  compareAtPrice BigInt?  @map("compare_at_price")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId])
  @@index([storeId, variantId])
  @@map("price_list_prices")
}

model PriceListAssignment {
  id                String   @id @default(uuid()) @db.Uuid
  priceListId       String   @map("price_list_id") @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  companyId         String?  @map("company_id") @db.Uuid
  companyLocationId String?  @map("company_location_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  priceList PriceList        @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  company   Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location  CompanyLocation? @relation(fields: [companyLocationId], references: [id], onDelete: Cascade)

  @@index([priceListId])
  @@index([storeId, companyId])
  @@index([storeId, companyLocationId])
  @@map("price_list_assignments")
}

enum PricingScope {
  variant
  product
  collection
  store
}

enum VolumeTierType {
  fixed_price
  percent_off
}

// Quantity breaks. `tiers` is a validated JSON array of { minQuantity, value } sorted by
// minQuantity; value is a unit price in minor units (fixed_price) or basis points off
// (percent_off). A rule bound to a price list only applies when that list was used.
model VolumePricingRule {
  id             String         @id @default(uuid()) @db.Uuid
  storeId        String         @map("store_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  scope          PricingScope
  scopeId        String?        @map("scope_id") @db.Uuid
  priceListId    String?        @map("price_list_id") @db.Uuid
  tierType       VolumeTierType @map("tier_type")
  tiers          Json
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceList    PriceList?   @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([storeId, scope, scopeId])
  @@index([storeId, isActive])
  @@map("volume_pricing_rules")
}

// Minimum / maximum / increment per variant or product, enforced by carts and checkout.
model QuantityRule {
  id             String       @id @default(uuid()) @db.Uuid
  storeId        String       @map("store_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  scope          PricingScope
  scopeId        String       @map("scope_id") @db.Uuid
  minQuantity    Int?         @map("min_quantity")
  maxQuantity    Int?         @map("max_quantity")
  increment      Int?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([storeId, scope, scopeId])
  @@map("quantity_rules")
}

// A negotiated unit price for one company (or one of its locations) on one variant.
// Beats every list and tier; optional validity window.
model ContractPrice {
  id                String    @id @default(uuid()) @db.Uuid
  storeId           String    @map("store_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  companyLocationId String?   @map("company_location_id") @db.Uuid
  variantId         String    @map("variant_id") @db.Uuid
  price             BigInt
  validFrom         DateTime? @map("valid_from") @db.Timestamptz(6)
  validTo           DateTime? @map("valid_to") @db.Timestamptz(6)
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location     CompanyLocation? @relation(fields: [companyLocationId], references: [id], onDelete: Cascade)
  variant      ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Partial unique indexes on (company_id, variant_id) / (company_location_id, variant_id) in the migration.
  @@index([storeId, companyId])
  @@index([storeId, companyLocationId])
  @@index([storeId, variantId])
  @@map("contract_prices")
}

// ---------------------------------------------------------------------------
// Commerce: carts, orders, draft orders
// ---------------------------------------------------------------------------

enum CartStatus {
  active
  completed
  abandoned
}

// A cart is a buyer intent, priced on read by PricingService; nothing in it is trusted at
// checkout, which re-quotes every line before an order is written.
model Cart {
  id                String     @id @default(uuid()) @db.Uuid
  storeId           String     @map("store_id") @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  status            CartStatus @default(active)
  customerId        String?    @map("customer_id") @db.Uuid
  companyId         String?    @map("company_id") @db.Uuid
  companyLocationId String?    @map("company_location_id") @db.Uuid
  email             String?
  currency          String     @db.Char(3)
  poNumber          String?    @map("po_number")
  note              String?
  shippingAddress   Json?      @map("shipping_address")
  billingAddress    Json?      @map("billing_address")
  shippingRateId    String?    @map("shipping_rate_id") @db.Uuid
  paymentMethodId   String?    @map("payment_method_id") @db.Uuid
  completedOrderId  String?    @map("completed_order_id") @db.Uuid
  expiresAt         DateTime?  @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  company       Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  location      CompanyLocation? @relation(fields: [companyLocationId], references: [id], onDelete: SetNull)
  shippingRate  ShippingRate?    @relation(fields: [shippingRateId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod?   @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  items         CartItem[]

  @@index([storeId, status, updatedAt(sort: Desc)])
  @@index([storeId, customerId])
  @@index([storeId, companyId])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cartId     String   @map("cart_id") @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  quantity   Int
  properties Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

enum OrderStatus {
  pending_approval
  confirmed
  processing
  completed
  cancelled
}

enum PaymentStatus {
  pending
  authorized
  paid
  partially_paid
  partially_refunded
  refunded
  voided
}

enum FulfillmentStatus {
  unfulfilled
  partially_fulfilled
  fulfilled
}

enum OrderSource {
  storefront
  draft_order
  quote
  admin
  api
}

enum PriceSourceKind {
  contract
  price_list
  volume
  base
  custom
}

// Immutable commercial record. Money columns are minor units in `currency`; the item rows
// snapshot title/sku/price so later catalog edits never rewrite history.
model Order {
  id                String            @id @default(uuid()) @db.Uuid
  storeId           String            @map("store_id") @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  number            Int
  name              String
  status            OrderStatus       @default(confirmed)
  paymentStatus     PaymentStatus     @default(pending) @map("payment_status")
  fulfillmentStatus FulfillmentStatus @default(unfulfilled) @map("fulfillment_status")
  source            OrderSource
  customerId        String?           @map("customer_id") @db.Uuid
  companyId         String?           @map("company_id") @db.Uuid
  companyLocationId String?           @map("company_location_id") @db.Uuid
  email             String?
  currency          String            @db.Char(3)
  poNumber          String?           @map("po_number")
  note              String?
  tags              String[]          @default([])
  itemCount         Int               @map("item_count")
  subtotal          BigInt
  discountTotal     BigInt            @default(0) @map("discount_total")
  shippingTotal     BigInt            @default(0) @map("shipping_total")
  taxTotal          BigInt            @default(0) @map("tax_total")
  total             BigInt
  shippingAddress   Json?             @map("shipping_address")
  billingAddress    Json?             @map("billing_address")
  shippingRateId    String?           @map("shipping_rate_id") @db.Uuid
  shippingRateName  String?           @map("shipping_rate_name")
  cartId            String?           @map("cart_id") @db.Uuid
  draftOrderId      String?           @map("draft_order_id") @db.Uuid
  placedById        String?           @map("placed_by_id") @db.Uuid
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelReason      String?           @map("cancel_reason")
  closedAt          DateTime?         @map("closed_at") @db.Timestamptz(6)
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  company      Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  location     CompanyLocation? @relation(fields: [companyLocationId], references: [id], onDelete: SetNull)
  placedBy     User?            @relation("OrderPlacedBy", fields: [placedById], references: [id], onDelete: SetNull)
  shippingRate ShippingRate?    @relation(fields: [shippingRateId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  events       OrderEvent[]
  payments     Payment[]
  refunds      Refund[]
  fulfillments Fulfillment[]
  returns      Return[]
  invoices     Invoice[]
  approvals    Approval[]

  @@unique([storeId, number])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([storeId, paymentStatus])
  @@index([storeId, fulfillmentStatus])
  @@index([storeId, customerId])
  @@index([storeId, companyId])
  @@index([storeId, email])
  @@map("orders")
}

model OrderItem {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  storeId           String          @map("store_id") @db.Uuid
  variantId         String?         @map("variant_id") @db.Uuid
  productId         String?         @map("product_id") @db.Uuid
  title             String
  variantTitle      String          @map("variant_title")
  sku               String?
  quantity          Int
  unitPrice         BigInt          @map("unit_price")
  compareAtPrice    BigInt?         @map("compare_at_price")
  priceSource       PriceSourceKind @map("price_source")
  discount          BigInt          @default(0)
  tax               BigInt          @default(0)
  lineTotal         BigInt          @map("line_total")
  requiresShipping  Boolean         @default(true) @map("requires_shipping")
  taxable           Boolean         @default(true)
  fulfilledQuantity Int             @default(0) @map("fulfilled_quantity")
  refundedQuantity  Int             @default(0) @map("refunded_quantity")
  position          Int
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant          ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reservations     OrderItemReservation[]
  refundItems      RefundItem[]
  fulfillmentItems FulfillmentItem[]
  returnItems      ReturnItem[]

  @@index([orderId, position])
  @@index([storeId, variantId])
  @@map("order_items")
}

// Stock held for an open order at a location. Fulfilment (Phase 7) converts a reservation
// into a movement; cancellation releases it.
model OrderItemReservation {
  id              String    @id @default(uuid()) @db.Uuid
  orderItemId     String    @map("order_item_id") @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  inventoryItemId String    @map("inventory_item_id") @db.Uuid
  locationId      String    @map("location_id") @db.Uuid
  quantity        Int
  releasedAt      DateTime? @map("released_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([storeId, inventoryItemId, locationId])
  @@map("order_item_reservations")
}

model OrderEvent {
  id        String    @id @default(uuid()) @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  type      String
  payload   Json      @default("{}")
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

enum DraftOrderStatus {
  open
  completed
  cancelled
}

// Staff-built order (phone, sales rep, negotiated). Lines are quoted through PricingService
// and may carry a custom price; completing it runs the same placement pipeline as checkout.
model DraftOrder {
  id                String           @id @default(uuid()) @db.Uuid
  storeId           String           @map("store_id") @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  number            Int
  name              String
  status            DraftOrderStatus @default(open)
  customerId        String?          @map("customer_id") @db.Uuid
  companyId         String?          @map("company_id") @db.Uuid
  companyLocationId String?          @map("company_location_id") @db.Uuid
  email             String?
  currency          String           @db.Char(3)
  poNumber          String?          @map("po_number")
  note              String?
  tags              String[]         @default([])
  shippingAddress   Json?            @map("shipping_address")
  billingAddress    Json?            @map("billing_address")
  shippingRateId    String?          @map("shipping_rate_id") @db.Uuid
  subtotal          BigInt           @default(0)
  total             BigInt           @default(0)
  completedOrderId  String?          @map("completed_order_id") @db.Uuid
  createdById       String           @map("created_by_id") @db.Uuid
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  company      Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  location     CompanyLocation? @relation(fields: [companyLocationId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("DraftOrderCreatedBy", fields: [createdById], references: [id])
  shippingRate ShippingRate?    @relation(fields: [shippingRateId], references: [id], onDelete: SetNull)
  items        DraftOrderItem[]

  @@unique([storeId, number])
  @@index([storeId, status, updatedAt(sort: Desc)])
  @@map("draft_orders")
}

model DraftOrderItem {
  id           String          @id @default(uuid()) @db.Uuid
  draftOrderId String          @map("draft_order_id") @db.Uuid
  storeId      String          @map("store_id") @db.Uuid
  variantId    String          @map("variant_id") @db.Uuid
  quantity     Int
  unitPrice    BigInt          @map("unit_price")
  priceSource  PriceSourceKind @map("price_source")
  position     Int

  draftOrder DraftOrder     @relation(fields: [draftOrderId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([draftOrderId, variantId])
  @@map("draft_order_items")
}

// Replay protection for money-moving calls (spec §34). Same key + same request → stored
// response; same key + different request → idempotency_conflict.
model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Payments, shipping, fulfilment, returns, taxes
// ---------------------------------------------------------------------------

// A payment method a store offers, backed by a provider adapter ("manual" = offline
// settlement confirmed by staff, "test" = sandbox). Real PSPs register under new keys.
model PaymentMethod {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  provider       String
  name           String
  instructions   String?
  config         Json     @default("{}")
  isEnabled      Boolean  @default(true) @map("is_enabled")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]
  carts        Cart[]

  @@unique([storeId, name])
  @@index([storeId, isEnabled, position])
  @@map("payment_methods")
}

enum PaymentRecordStatus {
  pending
  authorized
  captured
  voided
  failed
}

enum PaymentTransactionKind {
  authorize
  capture
  void
  refund
}

enum PaymentTransactionStatus {
  succeeded
  failed
  pending
}

model Payment {
  id              String              @id @default(uuid()) @db.Uuid
  storeId         String              @map("store_id") @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  orderId         String              @map("order_id") @db.Uuid
  paymentMethodId String?             @map("payment_method_id") @db.Uuid
  provider        String
  methodName      String              @map("method_name")
  status          PaymentRecordStatus @default(pending)
  amount          BigInt
  capturedAmount  BigInt              @default(0) @map("captured_amount")
  refundedAmount  BigInt              @default(0) @map("refunded_amount")
  currency        String              @db.Char(3)
  providerRef     String?             @map("provider_ref")
  failureReason   String?             @map("failure_reason")
  createdById     String?             @map("created_by_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  transactions    PaymentTransaction[]
  refunds         Refund[]
  invoicePayments InvoicePayment[]

  @@index([storeId, orderId])
  @@index([storeId, provider, providerRef])
  @@map("payments")
}

model PaymentTransaction {
  id          String                   @id @default(uuid()) @db.Uuid
  paymentId   String                   @map("payment_id") @db.Uuid
  storeId     String                   @map("store_id") @db.Uuid
  kind        PaymentTransactionKind
  status      PaymentTransactionStatus
  amount      BigInt
  providerRef String?                  @map("provider_ref")
  raw         Json?
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
}

enum RefundStatus {
  pending
  succeeded
  failed
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  storeId        String       @map("store_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  paymentId      String?      @map("payment_id") @db.Uuid
  amount         BigInt
  currency       String       @db.Char(3)
  reason         String?
  status         RefundStatus @default(pending)
  restock        Boolean      @default(false)
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items        RefundItem[]
  returns      Return[]

  @@index([storeId, orderId])
  @@map("refunds")
}

model RefundItem {
  id          String  @id @default(uuid()) @db.Uuid
  refundId    String  @map("refund_id") @db.Uuid
  orderItemId String  @map("order_item_id") @db.Uuid
  quantity    Int
  locationId  String? @map("location_id") @db.Uuid

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("refund_items")
}

enum ShippingRateType {
  flat
  free
  weight_based
  price_based
  pickup
  freight
}

// A zone is a set of countries ("*" = everywhere else); rates inside it apply when their
// subtotal / weight conditions hold. Checkout lets the buyer pick one applicable rate.
model ShippingZone {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  countries      String[] @default([])
  isActive       Boolean  @default(true) @map("is_active")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rates        ShippingRate[]

  @@unique([storeId, name])
  @@index([storeId, isActive, position])
  @@map("shipping_zones")
}

model ShippingRate {
  id             String           @id @default(uuid()) @db.Uuid
  zoneId         String           @map("zone_id") @db.Uuid
  storeId        String           @map("store_id") @db.Uuid
  name           String
  description    String?
  type           ShippingRateType @default(flat)
  price          BigInt           @default(0)
  minSubtotal    BigInt?          @map("min_subtotal")
  maxSubtotal    BigInt?          @map("max_subtotal")
  minWeightGrams Int?             @map("min_weight_grams")
  maxWeightGrams Int?             @map("max_weight_grams")
  isActive       Boolean          @default(true) @map("is_active")
  position       Int              @default(0)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone        ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  carts       Cart[]
  draftOrders DraftOrder[]
  orders      Order[]

  @@index([zoneId, isActive, position])
  @@index([storeId])
  @@map("shipping_rates")
}

enum FulfillmentState {
  pending
  shipped
  delivered
  cancelled
}

// Units leaving a location for an order. Creating one consumes the reservation and writes
// the inventory movement; tracking lives on the fulfilment.
model Fulfillment {
  id              String           @id @default(uuid()) @db.Uuid
  storeId         String           @map("store_id") @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  orderId         String           @map("order_id") @db.Uuid
  locationId      String?          @map("location_id") @db.Uuid
  status          FulfillmentState @default(pending)
  trackingCarrier String?          @map("tracking_carrier")
  trackingNumber  String?          @map("tracking_number")
  trackingUrl     String?          @map("tracking_url")
  note            String?
  shippedAt       DateTime?        @map("shipped_at") @db.Timestamptz(6)
  deliveredAt     DateTime?        @map("delivered_at") @db.Timestamptz(6)
  cancelledAt     DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  createdById     String?          @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  location     Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items        FulfillmentItem[]

  @@index([storeId, orderId])
  @@index([storeId, status])
  @@map("fulfillments")
}

model FulfillmentItem {
  id            String @id @default(uuid()) @db.Uuid
  fulfillmentId String @map("fulfillment_id") @db.Uuid
  orderItemId   String @map("order_item_id") @db.Uuid
  quantity      Int

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("fulfillment_items")
}

enum ReturnStatus {
  requested
  approved
  received
  closed
  declined
}

enum ReturnResolution {
  refund
  exchange
  store_credit
  none
}

model Return {
  id             String           @id @default(uuid()) @db.Uuid
  storeId        String           @map("store_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  orderId        String           @map("order_id") @db.Uuid
  status         ReturnStatus     @default(requested)
  reason         String
  resolution     ReturnResolution @default(refund)
  note           String?
  locationId     String?          @map("location_id") @db.Uuid
  refundId       String?          @map("refund_id") @db.Uuid
  receivedAt     DateTime?        @map("received_at") @db.Timestamptz(6)
  closedAt       DateTime?        @map("closed_at") @db.Timestamptz(6)
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refund       Refund?      @relation(fields: [refundId], references: [id], onDelete: SetNull)
  items        ReturnItem[]

  @@index([storeId, orderId])
  @@index([storeId, status])
  @@map("returns")
}

model ReturnItem {
  id          String  @id @default(uuid()) @db.Uuid
  returnId    String  @map("return_id") @db.Uuid
  orderItemId String  @map("order_item_id") @db.Uuid
  quantity    Int
  condition   String?
  restock     Boolean @default(true)

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("return_items")
}

// Tax rules: the most specific active rule for the shipping address wins (province beats
// country). Rates in basis points; store.prices_include_tax decides inclusive vs added.
model TaxRule {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  countryCode    String   @map("country_code") @db.Char(2)
  provinceCode   String?  @map("province_code")
  rateBps        Int      @map("rate_bps")
  isActive       Boolean  @default(true) @map("is_active")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([storeId, countryCode, provinceCode])
  @@map("tax_rules")
}

// ---------------------------------------------------------------------------
// Markets (Phase 8)
// ---------------------------------------------------------------------------

model Market {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  currency       String   @db.Char(3)
  locale         String
  countryCode    String   @map("country_code") @db.Char(2)
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Unique index on (storeId, isDefault) WHERE isDefault = true in migration.
  @@index([storeId, isActive])
  @@map("markets")
}

// ---------------------------------------------------------------------------
// Content (Phase 8)
// ---------------------------------------------------------------------------

enum PageStatus {
  draft
  published
  archived
}

model Page {
  id             String     @id @default(uuid()) @db.Uuid
  storeId        String     @map("store_id") @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  title          String
  handle         String
  bodyRich       Json       @default("{}") @map("body_rich")
  seoTitle       String?    @map("seo_title")
  seoDescription String?    @map("seo_description")
  templateSuffix String?    @map("template_suffix")
  status         PageStatus @default(draft)
  publishedAt    DateTime?  @map("published_at") @db.Timestamptz(6)
  createdById    String     @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@unique([storeId, handle])
  @@index([storeId, status])
  @@map("pages")
}

model Blog {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String
  handle         String
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  articles     Article[]

  @@unique([storeId, handle])
  @@map("blogs")
}

model Article {
  id               String     @id @default(uuid()) @db.Uuid
  storeId          String     @map("store_id") @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  blogId           String     @map("blog_id") @db.Uuid
  title            String
  handle           String
  bodyRich         Json       @default("{}") @map("body_rich")
  excerpt          String?
  authorName       String?    @map("author_name")
  featuredImageUrl String?    @map("featured_image_url")
  featuredImageAlt String?    @map("featured_image_alt")
  tags             String[]   @default([])
  seoTitle         String?    @map("seo_title")
  seoDescription   String?    @map("seo_description")
  templateSuffix   String?    @map("template_suffix")
  status           PageStatus @default(draft)
  publishedAt      DateTime?  @map("published_at") @db.Timestamptz(6)
  createdById      String     @map("created_by_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blog         Blog         @relation(fields: [blogId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@unique([blogId, handle])
  @@index([storeId, status])
  @@index([blogId, status, publishedAt])
  @@map("articles")
}

model Menu {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String
  handle         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@unique([storeId, handle])
  @@map("menus")
}

model MenuItem {
  id       String  @id @default(uuid()) @db.Uuid
  menuId   String  @map("menu_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  label    String
  url      String?
  position Int     @default(0)

  // Link-target metadata: when the link was chosen via a resource picker (product/collection/
  // page) rather than typed as a raw URL, `linkType` + `resourceId` record the original target
  // so the admin builder can re-select it on edit; `url` always holds the resolved href used by
  // the storefront regardless of how the link was picked.
  linkType String? @map("link_type") // "url" | "product" | "collection" | "page"
  resourceId String? @map("resource_id") @db.Uuid

  // Mega menu (top-level items only): when enabled, this item's children are rendered as
  // columns (child = column heading, grandchild = column link) instead of a flat flyout list,
  // plus an optional single featured image/link promo block.
  megaMenuEnabled Boolean @default(false) @map("mega_menu_enabled")
  promoImageUrl   String? @map("promo_image_url")
  promoImageAlt   String? @map("promo_image_alt")
  promoLinkLabel  String? @map("promo_link_label")
  promoLinkUrl    String? @map("promo_link_url")

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")

  @@index([menuId, parentId, position])
  @@map("menu_items")
}

model Redirect {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fromPath       String   @map("from_path")
  toPath         String   @map("to_path")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([storeId, fromPath])
  @@map("redirects")
}

// ---------------------------------------------------------------------------
// Domains (Phase 8)
// ---------------------------------------------------------------------------

enum DomainType {
  default
  custom
}

enum DomainStatus {
  pending
  verified
  failed
}

model Domain {
  id                String       @id @default(uuid()) @db.Uuid
  storeId           String       @map("store_id") @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  hostname          String       @unique
  type              DomainType   @default(custom)
  status            DomainStatus @default(pending)
  verificationToken String?      @map("verification_token")
  verifiedAt        DateTime?    @map("verified_at") @db.Timestamptz(6)
  sslStatus         String       @default("pending") @map("ssl_status")
  isPrimary         Boolean      @default(false) @map("is_primary")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Unique index on (storeId, isPrimary) WHERE isPrimary = true in migration.
  @@index([storeId])
  @@map("domains")
}

// ---------------------------------------------------------------------------
// Phase 9: Themes & Content
// ---------------------------------------------------------------------------

model Theme {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?
  category    String?  @db.VarChar(100)
  status      String   @default("active") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  releases    ThemeRelease[]
  storeThemes StoreTheme[]

  @@map("themes")
}

model ThemeRelease {
  id         String   @id @default(uuid()) @db.Uuid
  themeId    String   @map("theme_id") @db.Uuid
  version    String   @db.VarChar(50)
  manifest   Json     @db.JsonB
  releasedAt DateTime @default(now()) @map("released_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  theme       Theme        @relation(fields: [themeId], references: [id], onDelete: Restrict)
  storeThemes StoreTheme[]

  @@unique([themeId, version])
  @@map("theme_releases")
}

model StoreTheme {
  id                 String    @id @default(uuid()) @db.Uuid
  storeId            String    @map("store_id") @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  themeId            String    @map("theme_id") @db.Uuid
  themeReleaseId     String    @map("theme_release_id") @db.Uuid
  name               String    @db.VarChar(255)
  role               String    @default("unpublished") @db.VarChar(50) // main | unpublished
  publishedVersionId String?   @map("published_version_id") @db.Uuid
  publishedAt        DateTime? @map("published_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  theme        Theme               @relation(fields: [themeId], references: [id], onDelete: Restrict)
  release      ThemeRelease        @relation(fields: [themeReleaseId], references: [id], onDelete: Restrict)
  versions     StoreThemeVersion[]

  @@index([storeId])
  @@map("store_themes")
}

model StoreThemeVersion {
  id             String    @id @default(uuid()) @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  storeThemeId   String    @map("store_theme_id") @db.Uuid
  number         Int
  globalSettings Json      @default("{}") @map("global_settings") @db.JsonB
  status         String    @default("draft") @db.VarChar(50) // draft | published | archived
  etag           String    @db.VarChar(255)
  createdBy      String?   @map("created_by") @db.Uuid
  note           String?
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  storeTheme StoreTheme             @relation(fields: [storeThemeId], references: [id], onDelete: Cascade)
  templates  ThemeTemplateVersion[]
  previews   ThemePreviewToken[]

  @@unique([storeThemeId, number])
  @@index([storeId])
  @@map("store_theme_versions")
}

model ThemeTemplateVersion {
  id             String   @id @default(uuid()) @db.Uuid
  themeVersionId String   @map("theme_version_id") @db.Uuid
  templateType   String   @map("template_type") @db.VarChar(100)
  templateName   String   @map("template_name") @db.VarChar(100)
  configuration  Json     @default("{}") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  version StoreThemeVersion @relation(fields: [themeVersionId], references: [id], onDelete: Cascade)

  @@unique([themeVersionId, templateType, templateName])
  @@map("theme_template_versions")
}

model ThemePreviewToken {
  id                  String   @id @default(uuid()) @db.Uuid
  storeThemeVersionId String   @map("store_theme_version_id") @db.Uuid
  tokenHash           String   @unique @map("token_hash") @db.VarChar(255)
  passwordHash        String?  @map("password_hash") @db.VarChar(255)
  expiresAt           DateTime @map("expires_at") @db.Timestamptz
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  version StoreThemeVersion @relation(fields: [storeThemeVersionId], references: [id], onDelete: Cascade)

  @@index([storeThemeVersionId])
  @@map("theme_preview_tokens")
}

// ---------------------------------------------------------------------------
// Phase 12: B2B Advanced (Quotes, Credit, Approvals, Finance, Discounts)
// ---------------------------------------------------------------------------

enum QuoteStatus {
  draft
  sent
  accepted
  declined
  expired
  converted
}

enum InvoiceStatus {
  pending
  paid
  overdue
  cancelled
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum CreditExceedPolicy {
  reject
  warn
  allow
}

enum DiscountType {
  percentage
  fixed_amount
  free_shipping
}

enum DiscountMethod {
  code
  automatic
}

enum PaymentTermsType {
  immediate
  net
  deposit
  scheduled
}

model Quote {
  id                String      @id @default(uuid()) @db.Uuid
  storeId           String      @map("store_id") @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  number            String      @db.VarChar(50)
  companyId         String      @map("company_id") @db.Uuid
  companyLocationId String?     @map("company_location_id") @db.Uuid
  customerId        String      @map("customer_id") @db.Uuid
  status            QuoteStatus @default(draft)
  currency          String      @db.Char(3)
  expiresAt         DateTime?   @map("expires_at") @db.Timestamptz
  paymentTerms      Json        @default("{}") @map("payment_terms") @db.JsonB
  notes             String?
  internalNotes     String?     @map("internal_notes")
  convertedOrderId  String?     @map("converted_order_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyLocation CompanyLocation?  @relation(fields: [companyLocationId], references: [id], onDelete: SetNull)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items           QuoteItem[]
  events          QuoteEvent[]
  attachments     QuoteAttachment[]

  @@unique([storeId, number])
  @@index([storeId])
  @@index([companyId])
  @@map("quotes")
}

model QuoteItem {
  id        String   @id @default(uuid()) @db.Uuid
  quoteId   String   @map("quote_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  unitPrice BigInt   @map("unit_price")
  discount  BigInt   @default(0)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  quote   Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteEvent {
  id        String   @id @default(uuid()) @db.Uuid
  quoteId   String   @map("quote_id") @db.Uuid
  type      String   @db.VarChar(50)
  payload   Json     @default("{}") @db.JsonB
  actorId   String?  @map("actor_id") @db.Uuid
  actorType String?  @map("actor_type") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_events")
}

model QuoteAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  quoteId   String   @map("quote_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([quoteId, mediaId])
  @@map("quote_attachments")
}

model CreditAccount {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String?            @map("company_id") @db.Uuid
  companyLocationId String?            @map("company_location_id") @db.Uuid
  limit             BigInt
  used              BigInt             @default(0)
  currency          String             @db.Char(3)
  onExceedPolicy    CreditExceedPolicy @default(reject) @map("on_exceed_policy")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyLocation CompanyLocation? @relation(fields: [companyLocationId], references: [id], onDelete: Cascade)
  ledgerEntries   CreditLedger[]

  // Only one of companyId or companyLocationId should be set, but we enforce via logic.
  @@index([companyId])
  @@index([companyLocationId])
  @@map("credit_accounts")
}

model CreditLedger {
  id              String   @id @default(uuid()) @db.Uuid
  creditAccountId String   @map("credit_account_id") @db.Uuid
  delta           BigInt
  referenceType   String   @map("reference_type") @db.VarChar(50)
  referenceId     String   @map("reference_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  account CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@index([creditAccountId])
  @@map("credit_ledger")
}

model PaymentTermsTemplate {
  id             String           @id @default(uuid()) @db.Uuid
  storeId        String           @map("store_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(255)
  type           PaymentTermsType
  config         Json             @default("{}") @db.JsonB
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("payment_terms_templates")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  storeId        String        @map("store_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  number         String        @db.VarChar(50)
  dueAt          DateTime      @map("due_at") @db.Timestamptz
  status         InvoiceStatus @default(pending)
  amount         BigInt
  paidAmount     BigInt        @default(0) @map("paid_amount")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments     InvoicePayment[]

  @@unique([storeId, number])
  @@index([companyId])
  @@map("invoices")
}

model InvoicePayment {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_payments")
}

model ApprovalRule {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String?  @map("company_id") @db.Uuid
  conditions     Json     @default("{}") @db.JsonB
  approverRoles  String[] @default([]) @map("approver_roles")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvals    Approval[]

  @@index([storeId])
  @@map("approval_rules")
}

model Approval {
  id             String         @id @default(uuid()) @db.Uuid
  storeId        String         @map("store_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  orderId        String?        @map("order_id") @db.Uuid
  quoteId        String?        @map("quote_id") @db.Uuid
  ruleId         String         @map("rule_id") @db.Uuid
  status         ApprovalStatus @default(pending)
  decidedById    String?        @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?      @map("decided_at") @db.Timestamptz
  note           String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // We don't strictly relation to quote here to keep schema simple, or we can use generic string for target, 
  // but explicitly linking is fine if order and quote are optional.
  decidedBy    User?        @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@map("approvals")
}

model SavedList {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  companyId      String?  @map("company_id") @db.Uuid
  name           String   @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items        SavedListItem[]

  @@index([storeId])
  @@map("saved_lists")
}

model SavedListItem {
  id        String   @id @default(uuid()) @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  list    SavedList      @relation(fields: [listId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([listId, variantId])
  @@map("saved_list_items")
}

model Discount {
  id             String         @id @default(uuid()) @db.Uuid
  storeId        String         @map("store_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  type           DiscountType
  method         DiscountMethod
  value          Json           @db.JsonB // { amount?: 10, percent?: 15 }
  conditions     Json           @default("{}") @db.JsonB
  startsAt       DateTime       @map("starts_at") @db.Timestamptz
  endsAt         DateTime?      @map("ends_at") @db.Timestamptz
  usageLimit     Int?           @map("usage_limit")
  usageCount     Int            @default(0) @map("usage_count")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  codes        DiscountCode[]

  @@index([storeId])
  @@map("discounts")
}

model DiscountCode {
  id         String   @id @default(uuid()) @db.Uuid
  discountId String   @map("discount_id") @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  code       String   @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  // Scoped per store, not global: two different stores may reuse the same code.
  @@unique([storeId, code])
  @@index([discountId])
  @@map("discount_codes")
}

// ---------------------------------------------------------------------------
// Platform (Phase 14) — billing for the SaaS platform itself, not to be confused with the
// merchant-to-customer commerce above. Plans are a platform-owned catalog (no tenant column,
// same pattern as Theme); Subscription is the organization's one link into it.
// ---------------------------------------------------------------------------

enum PlanStatus {
  active
  archived
}

model Plan {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  name        String
  description String?
  // { "<currency>": { "monthly": <minor units>, "yearly": <minor units> } }, or null ("contact us").
  prices      Json?
  status      PlanStatus @default(active)
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  entitlements  Entitlement[]
  subscriptions Subscription[]

  @@map("plans")
}

// A plan's limits/features as a flat key-value bag (e.g. "stores.max": 5, "staff.max": 20,
// "feature.custom_domains": true) rather than dedicated columns, so new limits don't need a
// migration.
model Entitlement {
  id     String @id @default(uuid()) @db.Uuid
  planId String @map("plan_id") @db.Uuid
  key    String
  value  Json

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("entitlements")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

// One per organization (billing is an organization concern, never a store concern — see
// docs/architecture/00-overview.md's tenancy hierarchy). providerRef stays null until a real
// payment processor is wired in; until then plan changes are a manual/self-serve assignment,
// mirroring the Phase 7 PaymentAdapter's manual/test adapters.
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @map("organization_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(trialing)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime           @default(now()) @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(6)
  cancelAt           DateTime?          @map("cancel_at") @db.Timestamptz(6)
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz(6)
  providerRef        String?            @map("provider_ref")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan              @relation(fields: [planId], references: [id])
  invoices     PlatformInvoice[]

  @@map("subscriptions")
}

enum PlatformInvoiceStatus {
  open
  paid
  void
}

// Ocean billing the organization for its subscription — distinct from the merchant-to-buyer
// `Invoice` model (Phase 12), which is the opposite direction of money.
model PlatformInvoice {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  amount         BigInt
  currency       String                @db.Char(3)
  status         PlatformInvoiceStatus @default(open)
  dueAt          DateTime              @map("due_at") @db.Timestamptz(6)
  paidAt         DateTime?             @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("platform_invoices")
}

// A flag can be globally on/off (defaultOn) and overridden per organization or per store via a
// target row. Toggling one's own org's targets is a self-serve beta opt-in (gated behind
// organization.billing, the same permission that gates plan changes) — there's no separate
// platform-operator role in this codebase to reserve flag rollout for.
model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  defaultOn   Boolean  @default(false) @map("default_on")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  targets FeatureFlagTarget[]

  @@map("feature_flags")
}

model FeatureFlagTarget {
  id             String   @id @default(uuid()) @db.Uuid
  flagId         String   @map("flag_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  storeId        String?  @map("store_id") @db.Uuid
  enabled        Boolean
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  flag         FeatureFlag   @relation(fields: [flagId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store?        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // A target is exactly one of org-level or store-level (never both, never neither — enforced by
  // SetFeatureFlagTargetInput's zod refine, and at the DB layer by a CHECK constraint plus two
  // partial unique indexes added in migration 20260919090000_platform_operator_role_and_flag_target_unique,
  // same "one-of-two" shape as CatalogAssignment/PriceListAssignment above. Prisma's schema
  // language has no WHERE-clause unique index, so those two constraints exist only in the
  // migration SQL, not modeled here — same as those other models.
  @@index([flagId, organizationId])
  @@index([flagId, storeId])
  @@map("feature_flag_targets")
}

// ---------------------------------------------------------------------------
// Developers (Phase 15) — API keys, custom apps (client_credentials only; there's no
// third-party app marketplace or consent-screen flow in this codebase, so "apps" here means
// a merchant's own integrations, same as Shopify custom apps), webhooks.
// ---------------------------------------------------------------------------

enum DeveloperAppStatus {
  active
  revoked
}

// A merchant-created integration: owns its own API keys/webhooks, and authenticates itself
// with the OAuth 2.0 client_credentials grant (POST /api/2026-01/oauth/token) — no
// authorization-code/consent flow, since the "developer" and the "authorizer" are the same
// store owner here.
model DeveloperApp {
  id               String             @id @default(uuid()) @db.Uuid
  storeId          String             @map("store_id") @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  name             String
  clientId         String             @unique @map("client_id")
  clientSecretHash String             @map("client_secret_hash")
  scopes           String[]
  status           DeveloperAppStatus @default(active)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  store            Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  apiKeys          ApiKey[]
  webhooks         Webhook[]
  blockDefinitions AppBlockDefinition[]

  @@index([storeId])
  @@map("developer_apps")
}

enum ApiKeyKind {
  static
  oauth_token
}

// One table for both merchant-issued static keys (kind=static, appId null) and short-lived
// tokens minted by the client_credentials grant (kind=oauth_token, appId set) — both are
// "a bearer credential scoped to a store with some permissions", verified the same way by
// ApiKeyGuard. The secret itself is never stored, only its hash (same pattern as
// UserToken/hashToken) — a caller who loses it must issue a new one.
model ApiKey {
  id             String     @id @default(uuid()) @db.Uuid
  storeId        String     @map("store_id") @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  appId          String?    @map("app_id") @db.Uuid
  name           String
  keyHash        String     @unique @map("key_hash")
  scopes         String[]
  kind           ApiKeyKind @default(static)
  expiresAt      DateTime?  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt     DateTime?  @map("last_used_at") @db.Timestamptz(6)
  revokedAt      DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  app   DeveloperApp? @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("api_keys")
}

enum WebhookStatus {
  active
  disabled
}

// The secret is encrypted (not hashed) because delivery needs the plaintext back to compute
// each payload's HMAC-SHA256 signature — see EncryptionService, reused from Phase 7/12's
// credential-at-rest pattern rather than inventing a new one.
model Webhook {
  id             String        @id @default(uuid()) @db.Uuid
  storeId        String        @map("store_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  appId          String?       @map("app_id") @db.Uuid
  topic          String
  url            String
  secretEnc      String        @map("secret_enc")
  status         WebhookStatus @default(active)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  app         DeveloperApp?     @relation(fields: [appId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([storeId, topic])
  @@map("webhooks")
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
}

model WebhookDelivery {
  id           String                @id @default(uuid()) @db.Uuid
  webhookId    String                @map("webhook_id") @db.Uuid
  eventId      String                @map("event_id") @db.Uuid
  attempt      Int                   @default(1)
  status       WebhookDeliveryStatus @default(pending)
  responseCode Int?                  @map("response_code")
  nextRetryAt  DateTime?             @map("next_retry_at") @db.Timestamptz(6)
  deliveredAt  DateTime?             @map("delivered_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

// An app-registered block TYPE (like a Shopify "app block"): stored and listable so a
// merchant can see what an installed app offers, but not yet merged into the live theme
// manifest's block picker in the editor — that integration touches ThemesService's
// already-large manifest resolution and deserves its own pass rather than a bolt-on here.
model AppBlockDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  appId          String   @map("app_id") @db.Uuid
  type           String
  label          String
  settingsSchema Json     @map("settings_schema")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  app DeveloperApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, type])
  @@map("app_block_definitions")
}

// ---------------------------------------------------------------------------
// Enterprise (Phase 16) — custom roles, SSO, impersonation for support.
// ---------------------------------------------------------------------------

// A store-defined role: a name plus a flat permission list, resolved by the exact same
// engine as the built-in StoreRole roles (see resolveStorePermissions's call site in
// TenantService.forStore) — never hard-coded, per docs/architecture/07-auth-and-rbac.md.
model CustomRole {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  permissions    String[]
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store   Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  members StoreMember[]

  @@unique([storeId, name])
  @@map("custom_roles")
}

enum SsoConnectionStatus {
  active
  disabled
}

// One per organization — SSO is an organization-wide login policy, not a per-store one (see
// the tenancy hierarchy in docs/architecture/00-overview.md). A real OIDC authorization-code
// relying party (WellKnownEndpoint discovery is not implemented — the three endpoint URLs are
// entered directly, since there's no library dependency added for OIDC discovery/JWKS in this
// codebase). clientSecretEnc uses EncryptionService, same pattern as Phase 15's webhook secrets.
// SECURITY NOTE: `domain` has no ownership verification (no DNS TXT challenge, unlike the real
// `Domain` model's verify flow) — SsoService.handleCallback therefore refuses to authenticate a
// caller as any pre-existing User who isn't already a member of THIS organization, so a forged
// SsoConnection can at most sign in/provision accounts within the configuring org, never take
// over an unrelated global account. A future domain-ownership-verification pass would remove
// the need for that restriction.
model SsoConnection {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @unique @map("organization_id") @db.Uuid
  domain                String
  issuer                String
  authorizationEndpoint String              @map("authorization_endpoint")
  tokenEndpoint         String              @map("token_endpoint")
  userinfoEndpoint      String              @map("userinfo_endpoint")
  clientId              String              @map("client_id")
  clientSecretEnc       String              @map("client_secret_enc")
  defaultRole           OrganizationRole    @default(member) @map("default_role")
  status                SsoConnectionStatus @default(active)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("sso_connections")
}

// A support-initiated "view as" session: the impersonator's own merchant session stays valid,
// but a second session is minted for the target user and both are logged here + in AuditLog.
// There's no separate platform-operator role/app in this codebase, so this is scoped to a
// store owner/admin impersonating a member of their OWN store (Zendesk/Intercom-style account
// troubleshooting), not cross-tenant platform support.
model ImpersonationSession {
  id                String    @id @default(uuid()) @db.Uuid
  storeId           String    @map("store_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  impersonatorUserId String   @map("impersonator_user_id") @db.Uuid
  targetUserId      String    @map("target_user_id") @db.Uuid
  reason            String
  sessionId         String    @map("session_id")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  endedAt           DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  store        Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  impersonator User  @relation("ImpersonatorUser", fields: [impersonatorUserId], references: [id], onDelete: Cascade)
  target       User  @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@map("impersonation_sessions")
}

// ---------------------------------------------------------------------------
// Global Localization: Country Engine (L1 foundation)
//
// A centralized, versioned configuration profile per country. Every field the rest of the
// localization system needs — address shape, postal code rules, tax terminology/ids, business
// entity types, and the dynamic business-profile onboarding form (spec section 17) — lives here
// as structured JSON on ONE row per ISO country. Deliberately no per-country tables and no
// per-country code branches: adding or revising a country (spec section 49, e.g.
// "TurkeyComplianceProfile, Version: 2026.09") is a data change (a new `version` + updated JSON),
// never a migration or a redeploy. Platform-owned catalog, no tenant column — same pattern as
// Theme/Plan.
// ---------------------------------------------------------------------------

model CountryProfile {
  id          String  @id @default(uuid()) @db.Uuid
  countryCode String  @unique @map("country_code") @db.VarChar(2) // ISO 3166-1 alpha-2
  name        String // official country name
  isActive    Boolean @default(true) @map("is_active")
  // Free-text compliance version, e.g. "2026.09" — bump this (and updatedAt follows automatically)
  // whenever a country's rules change, per spec section 49's versioned-compliance requirement.
  version     String  @default("2026.01") @db.VarChar(20)

  supportedCurrencies String[] @default([]) @map("supported_currencies") // ISO 4217 codes
  supportedLanguages  String[] @default([]) @map("supported_languages") // BCP-47 locale codes

  // AddressFieldDefinition[] (see @ocean/types countries.ts) — the field list, in order, this
  // country's address form should render (spec section 19: US differs from TR differs from JP).
  addressSchema Json @map("address_schema") @db.JsonB

  // PostalCodeRules | null — { regex, example, description }; null for a country with no postal
  // code system.
  postalCodeRules Json? @map("postal_code_rules") @db.JsonB

  stateProvinceRequired Boolean @default(false) @map("state_province_required")
  // Local label for the field, e.g. "State" (US), "Province" (TR), "County" (GB), "Prefecture" (JP).
  stateProvinceLabel    String? @map("state_province_label")

  // Free text, not an enum, so a new jurisdiction's tax system (e.g. "gst") never needs a
  // migration — e.g. "vat", "sales_tax", "gst", "none".
  taxSystemType String @map("tax_system_type")
  // TaxTerminology — { localName: "KDV", localFullName: "Katma Değer Vergisi", englishName: "VAT" }.
  taxTerminology Json @map("tax_terminology") @db.JsonB
  // TaxIdFormat[] — e.g. [{ code: "VKN", label: "Vergi Kimlik Numarası", regex, ... }].
  taxIdFormats Json @map("tax_id_formats") @db.JsonB

  // String identifiers only (e.g. "credit_card", "bank_transfer") — real payment method
  // implementations are out of scope for this engine.
  supportedPaymentMethods String[] @default([]) @map("supported_payment_methods")

  // BusinessEntityType[] — e.g. [{ code: "limited_sirket", label: "Limited Şirket" }].
  businessEntityTypes Json @map("business_entity_types") @db.JsonB

  // BusinessProfileFieldDefinition[] (spec section 17) — the dynamic onboarding/business-profile
  // form schema a future frontend phase renders directly from this data: key/label/description/
  // required/inputType/validationRegex/placeholder/visibilityRules (entity-type dependency).
  businessProfileSchema Json @map("business_profile_schema") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("country_profiles")
}
