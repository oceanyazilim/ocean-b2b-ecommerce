// Ocean Commerce — PostgreSQL schema
//
// Tenant-owned tables carry organizationId (+ storeId when store-scoped). Every repository
// method must filter by them; see docs/architecture/08-multi-tenant-model.md.
// Sessions are stored in Redis, not here (docs/architecture/07-auth-and-rbac.md).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
}

enum UserTokenPurpose {
  email_verification
  password_reset
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  name            String
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tokens               UserToken[]
  organizationMembers  OrganizationMember[]
  storeMembers         StoreMember[]
  sentInvitations      Invitation[]
  mfa                  UserMfa?
  loginEvents          LoginEvent[]
  inventoryMovements   InventoryMovement[]
  transfersRequested   TransferRequest[]    @relation("TransferRequestedBy")
  transfersApproved    TransferRequest[]    @relation("TransferApprovedBy")
  managedCompanies     Company[]            @relation("CompanyAccountManager")
  reviewedApplications CompanyApplication[] @relation("ApplicationReviewer")

  @@map("users")
}

model UserMfa {
  userId             String    @id @map("user_id") @db.Uuid
  totpSecretEnc      String    @map("totp_secret_enc")
  enabledAt          DateTime? @map("enabled_at") @db.Timestamptz(6)
  recoveryCodeHashes String[]  @default([]) @map("recovery_code_hashes")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

enum LoginOutcome {
  success
  failed_password
  failed_mfa
  mfa_required
  locked
}

model LoginEvent {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  email     String
  ip        String?
  userAgent String?      @map("user_agent")
  outcome   LoginOutcome
  riskFlags String[]     @default([]) @map("risk_flags")
  sessionId String?      @map("session_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
  @@map("login_events")
}

model UserToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("user_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy: Organization -> Store
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  active
  suspended
}

enum OrganizationRole {
  owner
  admin
  billing
  member
}

enum MembershipStatus {
  active
  removed
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  members             OrganizationMember[]
  stores              Store[]
  storeMembers        StoreMember[]
  invitations         Invitation[]
  auditLogs           AuditLog[]
  products            Product[]
  collections         Collection[]
  media               Media[]
  locations           Location[]
  inventoryItems      InventoryItem[]
  inventoryLevels     InventoryLevel[]
  transfers           TransferRequest[]
  customers           Customer[]
  companies           Company[]
  companyLocations    CompanyLocation[]
  companyUsers        CompanyUser[]
  companyApplications CompanyApplication[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

enum StoreStatus {
  setup
  active
  paused
  closed
}

enum StoreRole {
  store_owner
  admin
  store_manager
  product_manager
  order_manager
  marketing
  finance
  developer
  viewer
}

model Store {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  name            String
  slug            String      @unique
  defaultCurrency String      @map("default_currency") @db.Char(3)
  defaultLocale   String      @map("default_locale")
  timezone        String
  status          StoreStatus @default(setup)
  businessType    String?     @map("business_type")
  industry        String?
  onboardingState Json        @default("{}") @map("onboarding_state")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members              StoreMember[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
  products             Product[]
  variants             ProductVariant[]
  categories           Category[]
  collections          Collection[]
  media                Media[]
  metafieldDefinitions MetafieldDefinition[]
  metafields           Metafield[]
  events               DomainEvent[]
  locations            Location[]
  inventoryItems       InventoryItem[]
  inventoryLevels      InventoryLevel[]
  movements            InventoryMovement[]
  transfers            TransferRequest[]
  customers            Customer[]
  companies            Company[]
  companyLocations     CompanyLocation[]
  companyUsers         CompanyUser[]
  companyApplications  CompanyApplication[]

  @@index([organizationId])
  @@map("stores")
}

model StoreMember {
  id             String           @id @default(uuid()) @db.Uuid
  storeId        String           @map("store_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           StoreRole
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("store_members")
}

model Invitation {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  storeId          String?           @map("store_id") @db.Uuid
  email            String
  organizationRole OrganizationRole? @map("organization_role")
  storeRole        StoreRole?        @map("store_role")
  tokenHash        String            @unique @map("token_hash")
  invitedById      String            @map("invited_by_id") @db.Uuid
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?         @map("accepted_at") @db.Timestamptz(6)
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([storeId, email])
  @@index([organizationId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum ActorType {
  user
  platform
  system
}

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  storeId        String?   @map("store_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  action         String
  resourceType   String    @map("resource_type")
  resourceId     String?   @map("resource_id")
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?   @map("user_agent")
  sessionId      String?   @map("session_id")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  store        Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog: products, variants, media, categories
// ---------------------------------------------------------------------------

enum ProductStatus {
  draft
  active
  archived
}

enum WeightUnit {
  g
  kg
  lb
  oz
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  storeId         String        @map("store_id") @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  title           String
  handle          String
  descriptionHtml String        @default("") @map("description_html")
  vendor          String?
  productType     String?       @map("product_type")
  categoryId      String?       @map("category_id") @db.Uuid
  status          ProductStatus @default(draft)
  tags            String[]      @default([])
  seoTitle        String?       @map("seo_title")
  seoDescription  String?       @map("seo_description")
  templateSuffix  String?       @map("template_suffix")
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  version         Int           @default(1)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options      ProductOption[]
  variants     ProductVariant[]
  media        ProductMedia[]
  collections  CollectionProduct[]

  @@unique([storeId, handle])
  @@index([storeId, status, updatedAt(sort: Desc)])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, vendor])
  @@index([storeId, productType])
  @@map("products")
}

model ProductOption {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(uuid()) @db.Uuid
  optionId String @map("option_id") @db.Uuid
  value    String
  position Int

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

model ProductVariant {
  id               String     @id @default(uuid()) @db.Uuid
  productId        String     @map("product_id") @db.Uuid
  storeId          String     @map("store_id") @db.Uuid
  title            String
  sku              String?
  barcode          String?
  price            BigInt
  compareAtPrice   BigInt?    @map("compare_at_price")
  cost             BigInt?
  weight           Decimal?   @db.Decimal(12, 3)
  weightUnit       WeightUnit @default(kg) @map("weight_unit")
  taxable          Boolean    @default(true)
  requiresShipping Boolean    @default(true) @map("requires_shipping")
  position         Int
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  store          Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  optionValues   VariantOptionValue[]
  inventoryItems InventoryItem[]

  @@index([productId, position])
  @@index([storeId, sku])
  @@index([storeId, barcode])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

enum MediaKind {
  image
  video
  document
}

model Media {
  id               String    @id @default(uuid()) @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  kind             MediaKind
  storageKey       String    @unique @map("storage_key")
  mime             String
  bytes            Int
  width            Int?
  height           Int?
  alt              String?
  originalFilename String    @map("original_filename")
  createdById      String?   @map("created_by_id") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  store                Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products             ProductMedia[]
  collections          Collection[]
  applicationDocuments CompanyApplicationDocument[]

  @@index([storeId, kind, createdAt(sort: Desc)])
  @@map("media")
}

model ProductMedia {
  productId String @map("product_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid
  position  Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([productId, position])
  @@map("product_media")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  handle    String
  path      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, path])
  @@index([storeId, parentId, position])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Collections
// ---------------------------------------------------------------------------

enum CollectionType {
  manual
  automated
}

enum CollectionSortOrder {
  manual
  title_asc
  title_desc
  created_desc
  price_asc
  price_desc
}

enum CollectionProductSource {
  manual
  rule
}

model Collection {
  id              String              @id @default(uuid()) @db.Uuid
  storeId         String              @map("store_id") @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  title           String
  handle          String
  descriptionHtml String              @default("") @map("description_html")
  type            CollectionType
  rules           Json                @default("[]")
  rulesMatchAll   Boolean             @default(true) @map("rules_match_all")
  sortOrder       CollectionSortOrder @default(manual) @map("sort_order")
  imageMediaId    String?             @map("image_media_id") @db.Uuid
  seoTitle        String?             @map("seo_title")
  seoDescription  String?             @map("seo_description")
  publishedAt     DateTime?           @map("published_at") @db.Timestamptz(6)
  version         Int                 @default(1)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  image        Media?              @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  products     CollectionProduct[]

  @@unique([storeId, handle])
  @@index([storeId, type, updatedAt(sort: Desc)])
  @@map("collections")
}

model CollectionProduct {
  collectionId String                  @map("collection_id") @db.Uuid
  productId    String                  @map("product_id") @db.Uuid
  position     Int                     @default(0)
  source       CollectionProductSource @default(manual)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId, position])
  @@index([productId])
  @@map("collection_products")
}

// ---------------------------------------------------------------------------
// Metafields
// ---------------------------------------------------------------------------

enum MetafieldOwnerType {
  product
  variant
  collection
  company
  order
  customer
}

enum MetafieldType {
  single_line_text
  multi_line_text
  integer
  decimal
  boolean
  date
  json
  url
  product_reference
  collection_reference
  file_reference
}

model MetafieldDefinition {
  id          String             @id @default(uuid()) @db.Uuid
  storeId     String             @map("store_id") @db.Uuid
  ownerType   MetafieldOwnerType @map("owner_type")
  namespace   String
  key         String
  name        String
  description String?
  type        MetafieldType
  validations Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  metafields Metafield[]

  @@unique([storeId, ownerType, namespace, key])
  @@map("metafield_definitions")
}

model Metafield {
  id           String             @id @default(uuid()) @db.Uuid
  storeId      String             @map("store_id") @db.Uuid
  ownerType    MetafieldOwnerType @map("owner_type")
  ownerId      String             @map("owner_id") @db.Uuid
  definitionId String?            @map("definition_id") @db.Uuid
  namespace    String
  key          String
  type         MetafieldType
  value        Json
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  definition MetafieldDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)

  @@unique([storeId, ownerType, ownerId, namespace, key])
  @@index([storeId, ownerType, ownerId])
  @@map("metafields")
}

// ---------------------------------------------------------------------------
// Domain events (transactional outbox)
// ---------------------------------------------------------------------------

model DomainEvent {
  id             String    @id @default(uuid()) @db.Uuid
  storeId        String?   @map("store_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  type           String
  version        Int       @default(1)
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  payload        Json
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([publishedAt, occurredAt])
  @@index([storeId, type, occurredAt(sort: Desc)])
  @@map("domain_events")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

enum InventoryTrackingType {
  variant
  sku
  upc
}

enum InventoryMovementReason {
  adjustment
  transfer
  return
  damage
  count
}

enum InventoryMovementSource {
  manual
  system
  import
}

enum TransferStatus {
  pending
  approved
  rejected
  cancelled
}

model Location {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  type           String   @default("warehouse")
  address        String?
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]
  movementsFrom   InventoryMovement[] @relation("FromLocation")
  movementsTo     InventoryMovement[] @relation("ToLocation")
  transfersFrom   TransferRequest[]   @relation("FromLocation")
  transfersTo     TransferRequest[]   @relation("ToLocation")

  @@unique([storeId, name])
  @@index([storeId, isActive, isDefault])
  @@map("locations")
}

model InventoryItem {
  id               String                @id @default(uuid()) @db.Uuid
  storeId          String                @map("store_id") @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  productVariantId String?               @map("product_variant_id") @db.Uuid
  sku              String?
  upc              String?
  trackingType     InventoryTrackingType @map("tracking_type")
  onHand           Int                   @default(0) @map("on_hand")
  committed        Int                   @default(0)
  reserved         Int                   @default(0)
  damaged          Int                   @default(0)
  lastMovedAt      DateTime?             @map("last_moved_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  store            Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  levels           InventoryLevel[]
  movements        InventoryMovement[]
  transferRequests TransferRequest[]

  // Partial unique indexes (WHERE ... IS NOT NULL) are added in the migration SQL.
  @@index([storeId, productVariantId])
  @@index([storeId, sku])
  @@index([storeId, upc])
  @@map("inventory_items")
}

model InventoryLevel {
  id             String    @id @default(uuid()) @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  locationId     String    @map("location_id") @db.Uuid
  quantity       Int       @default(0)
  reserved       Int       @default(0)
  damaged        Int       @default(0)
  lastMovedAt    DateTime? @map("last_moved_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([storeId, locationId])
  @@index([itemId])
  @@map("inventory_levels")
}

model InventoryMovement {
  id             String                  @id @default(uuid()) @db.Uuid
  storeId        String                  @map("store_id") @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  itemId         String                  @map("item_id") @db.Uuid
  fromLocationId String?                 @map("from_location_id") @db.Uuid
  toLocationId   String?                 @map("to_location_id") @db.Uuid
  quantity       Int
  reason         InventoryMovementReason
  reference      String?
  source         InventoryMovementSource @default(manual)
  notes          String?
  createdById    String                  @map("created_by_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLocation Location?     @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location?     @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, itemId])
  @@index([storeId, reason])
  @@index([storeId, fromLocationId])
  @@index([storeId, toLocationId])
  @@map("inventory_movements")
}

model TransferRequest {
  id              String         @id @default(uuid()) @db.Uuid
  storeId         String         @map("store_id") @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  fromLocationId  String         @map("from_location_id") @db.Uuid
  toLocationId    String         @map("to_location_id") @db.Uuid
  itemId          String         @map("item_id") @db.Uuid
  quantity        Int
  status          TransferStatus @default(pending)
  requestedById   String         @map("requested_by_id") @db.Uuid
  approvedById    String?        @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(6)
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromLocation Location      @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location      @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requestedBy  User          @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy   User?         @relation("TransferApprovedBy", fields: [approvedById], references: [id])

  @@index([storeId, status])
  @@index([storeId, createdAt(sort: Desc)])
  @@map("transfer_requests")
}

// ---------------------------------------------------------------------------
// Customers & B2B companies
// ---------------------------------------------------------------------------

enum CustomerStatus {
  active
  disabled
}

enum MarketingConsent {
  not_subscribed
  subscribed
  unsubscribed
}

// Shoppers and company buyers share one record; the buyer facet is the company membership.
// Storefront login (Phase 8) fills password_hash / account_activated_at.
model Customer {
  id                      String           @id @default(uuid()) @db.Uuid
  storeId                 String           @map("store_id") @db.Uuid
  organizationId          String           @map("organization_id") @db.Uuid
  email                   String
  firstName               String?          @map("first_name")
  lastName                String?          @map("last_name")
  phone                   String?
  status                  CustomerStatus   @default(active)
  tags                    String[]         @default([])
  note                    String?
  locale                  String?
  taxExempt               Boolean          @default(false) @map("tax_exempt")
  emailMarketing          MarketingConsent @default(not_subscribed) @map("email_marketing")
  emailMarketingUpdatedAt DateTime?        @map("email_marketing_updated_at") @db.Timestamptz(6)
  passwordHash            String?          @map("password_hash")
  accountActivatedAt      DateTime?        @map("account_activated_at") @db.Timestamptz(6)
  ordersCount             Int              @default(0) @map("orders_count")
  totalSpent              BigInt           @default(0) @map("total_spent")
  lastOrderAt             DateTime?        @map("last_order_at") @db.Timestamptz(6)
  version                 Int              @default(1)
  deletedAt               DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addresses    CustomerAddress[]
  companyUsers CompanyUser[]
  applications CompanyApplication[]

  // Partial unique index on (store_id, email) WHERE deleted_at IS NULL lives in the migration.
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, status])
  @@index([storeId, email])
  @@index([storeId, lastName, firstName])
  @@map("customers")
}

model CustomerAddress {
  id                String   @id @default(uuid()) @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  // Validated postal address document (see addressSchema in @ocean/types).
  address           Json
  isDefaultShipping Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean  @default(false) @map("is_default_billing")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([storeId])
  @@map("customer_addresses")
}

enum CompanyStatus {
  active
  suspended
  archived
}

model Company {
  id               String        @id @default(uuid()) @db.Uuid
  storeId          String        @map("store_id") @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  legalName        String        @map("legal_name")
  displayName      String        @map("display_name")
  taxNumber        String?       @map("tax_number")
  taxOffice        String?       @map("tax_office")
  industry         String?
  currency         String        @db.Char(3)
  status           CompanyStatus @default(active)
  accountManagerId String?       @map("account_manager_id") @db.Uuid
  externalId       String?       @map("external_id")
  website          String?
  phone            String?
  email            String?
  note             String?
  tags             String[]      @default([])
  version          Int           @default(1)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  store          Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountManager User?                @relation("CompanyAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  locations      CompanyLocation[]
  users          CompanyUser[]
  applications   CompanyApplication[]

  // Partial unique index on (store_id, tax_number) WHERE tax_number IS NOT NULL AND deleted_at IS NULL in the migration.
  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, status])
  @@index([storeId, displayName])
  @@index([storeId, accountManagerId])
  @@map("companies")
}

// A branch / ship-to site of a company. Catalog, price list, payment terms and credit attach
// here in Phases 5 and 12; the location itself carries only what every order needs.
model CompanyLocation {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String
  externalId      String?  @map("external_id")
  phone           String?
  email           String?
  shippingAddress Json     @map("shipping_address")
  // null = same as shipping
  billingAddress  Json?    @map("billing_address")
  // null = company currency
  currency        String?  @db.Char(3)
  taxExempt       Boolean  @default(false) @map("tax_exempt")
  taxNumber       String?  @map("tax_number")
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userAccess   CompanyUserLocation[]

  // Partial unique index on (company_id) WHERE is_default = true in the migration.
  @@unique([companyId, name])
  @@index([storeId, companyId])
  @@map("company_locations")
}

enum CompanyRole {
  company_admin
  buyer
  approver
  finance
  viewer
}

enum CompanyUserStatus {
  active
  disabled
}

// Membership of a customer in a company. `allLocations` = false restricts the user to the
// locations listed in company_user_locations.
model CompanyUser {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  customerId     String            @map("customer_id") @db.Uuid
  storeId        String            @map("store_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  role           CompanyRole
  status         CompanyUserStatus @default(active)
  title          String?
  allLocations   Boolean           @default(true) @map("all_locations")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations    CompanyUserLocation[]

  @@unique([companyId, customerId])
  @@index([storeId, customerId])
  @@index([storeId, companyId])
  @@map("company_users")
}

model CompanyUserLocation {
  companyUserId     String @map("company_user_id") @db.Uuid
  companyLocationId String @map("company_location_id") @db.Uuid

  companyUser CompanyUser     @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  location    CompanyLocation @relation(fields: [companyLocationId], references: [id], onDelete: Cascade)

  @@id([companyUserId, companyLocationId])
  @@index([companyLocationId])
  @@map("company_user_locations")
}

enum CompanyApplicationStatus {
  pending
  under_review
  approved
  rejected
}

enum CompanyApplicationSource {
  storefront
  admin
}

// A wholesale-account request. Approval creates the company, its default location and the
// contact as company admin; the application keeps a pointer to what it produced.
model CompanyApplication {
  id                    String                   @id @default(uuid()) @db.Uuid
  storeId               String                   @map("store_id") @db.Uuid
  organizationId        String                   @map("organization_id") @db.Uuid
  status                CompanyApplicationStatus @default(pending)
  source                CompanyApplicationSource @default(storefront)
  legalName             String                   @map("legal_name")
  displayName           String?                  @map("display_name")
  taxNumber             String?                  @map("tax_number")
  taxOffice             String?                  @map("tax_office")
  industry              String?
  website               String?
  expectedMonthlyVolume String?                  @map("expected_monthly_volume")
  contactFirstName      String                   @map("contact_first_name")
  contactLastName       String                   @map("contact_last_name")
  contactEmail          String                   @map("contact_email")
  contactPhone          String?                  @map("contact_phone")
  address               Json?
  message               String?
  customerId            String?                  @map("customer_id") @db.Uuid
  reviewerId            String?                  @map("reviewer_id") @db.Uuid
  reviewedAt            DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  decisionNote          String?                  @map("decision_note")
  companyId             String?                  @map("company_id") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?                    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reviewer     User?                        @relation("ApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  company      Company?                     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  documents    CompanyApplicationDocument[]

  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([storeId, contactEmail])
  @@map("company_applications")
}

model CompanyApplicationDocument {
  applicationId String   @map("application_id") @db.Uuid
  mediaId       String   @map("media_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application CompanyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  media       Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([applicationId, mediaId])
  @@map("company_application_documents")
}
