# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://ocean:ocean@localhost:5432/ocean_dev?schema=public

# Redis (sessions, cache, BullMQ queues)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ocean-media
S3_ACCESS_KEY=ocean
S3_SECRET_KEY=oceanocean
S3_FORCE_PATH_STYLE=true

# Meilisearch (search index; used from Phase 8+)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=ocean-dev-master-key

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3100

# Sessions / auth (generate real random values outside dev: `openssl rand -hex 32`)
SESSION_SECRET=change-me-in-real-environments-0123456789
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# Leave unset to derive from NODE_ENV (secure cookies in production only)
# COOKIE_SECURE=false

# Where links in transactional emails point (verification, password reset, invitations)
ADMIN_URL=http://localhost:3001
MAIL_FROM=Ocean Commerce <no-reply@localhost>

# Encrypts secrets at rest (TOTP seeds, app tokens). 32 bytes hex: `openssl rand -hex 32`
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Media storage: local disk in dev (served by the API at MEDIA_PUBLIC_URL), S3/MinIO otherwise
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
MEDIA_PUBLIC_URL=http://localhost:4000/media

# Frontend app ports (used by `pnpm dev`)
MARKETING_PORT=3000
ADMIN_PORT=3001
STOREFRONT_PORT=3002
PLATFORM_ADMIN_PORT=3003

# Public API base URL consumed by frontends
NEXT_PUBLIC_API_URL=http://localhost:4000
