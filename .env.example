# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://ocean:ocean@localhost:5432/ocean_dev?schema=public

# Redis (sessions, cache, BullMQ queues)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ocean-media
S3_ACCESS_KEY=ocean
S3_SECRET_KEY=oceanocean
S3_FORCE_PATH_STYLE=true

# Meilisearch (search index; used from Phase 8+)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=ocean-dev-master-key

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Session / auth secrets (generate real random values outside dev)
SESSION_SECRET=change-me-in-real-environments

# Frontend app ports (used by `pnpm dev`)
MARKETING_PORT=3000
ADMIN_PORT=3001
STOREFRONT_PORT=3002
PLATFORM_ADMIN_PORT=3003

# Public API base URL consumed by frontends
NEXT_PUBLIC_API_URL=http://localhost:4000
